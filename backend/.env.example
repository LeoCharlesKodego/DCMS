# =============================================================================
# ONP DCMS - environment template. ONE file, switchable blocks.
#
# Copy to .env and fill in the secret values (APP_KEY, DB_PASSWORD, ...).
#
# HOW IT WORKS
#   A line is active when it has no leading "#". Each setup below is a labeled
#   block: to switch, comment or uncomment that whole block. Only one block of
#   each conflicting pair may be active at a time - see the note above each
#   block for which block it conflicts with.
#
#   After ANY change:   php artisan config:clear
#                       then restart:  php artisan serve
# =============================================================================

# -----------------------------------------------------------------------------
# COMMON - ACTIVE (always on). Shared by every setup; do not comment this block,
# except the single lines named in the NGROK block note when enabling ngrok.
# -----------------------------------------------------------------------------
APP_NAME="ONP DCMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local storage, queue, cache, mail and cloud defaults.
# The NGROK block overrides several of these - see its header note.
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# DATABASE A - SQLite - ACTIVE now.
# CONFLICT: enable only one of DATABASE A or DATABASE B.
# -----------------------------------------------------------------------------
DB_CONNECTION=sqlite

# -----------------------------------------------------------------------------
# DATABASE B - MySQL - OFF (every line commented).
# CONFLICT: enable only one of DATABASE A or DATABASE B.
# To use it: comment DB_CONNECTION in DATABASE A, then uncomment every line here.
# -----------------------------------------------------------------------------
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=dcms
# DB_USERNAME=dcms_app
# DB_PASSWORD=

# -----------------------------------------------------------------------------
# NGROK / public demo - OFF (every line commented).
# CONFLICT: this block conflicts with LOCAL URLS, with DATABASE A, and with the
# APP_ENV / APP_DEBUG / LOG_* / CACHE_STORE / QUEUE_CONNECTION /
# FILESYSTEM_DISK / MAIL_MAILER lines in COMMON.
# When NGROK is enabled:
#   1. comment out the whole LOCAL URLS block,
#   2. comment DB_CONNECTION in DATABASE A (this block sets its own sqlite path),
#   3. comment the COMMON lines listed above, then uncomment this whole block.
# The app only reads these when APP_ENV=ngrok (see bootstrap/app.php).
# demo:change-ngrok-passwords additionally requires APP_ENV=ngrok plus the
# isolated sqlite database below; run it from the backend/ directory.
# SANCTUM_STATEFUL_DOMAINS is listed for reference: Sanctum is not installed in
# this project, so the key currently has no effect.
# Replace YOUR-SUBDOMAIN with the assigned ngrok dev hostname.
# -----------------------------------------------------------------------------
# APP_ENV=ngrok
# APP_DEBUG=false
# APP_URL=https://YOUR-SUBDOMAIN.ngrok-free.app
# APP_ALLOWED_HOST_PATTERN=^YOUR-SUBDOMAIN\.ngrok-free\.app$
# TRUSTED_PROXIES=127.0.0.1,::1
# APP_STORAGE_PATH=local-demo/ngrok-storage

# DB_CONNECTION=sqlite
# DB_DATABASE=local-demo/ngrok/database.sqlite

# SANCTUM_STATEFUL_DOMAINS=YOUR-SUBDOMAIN.ngrok-free.app
# SESSION_DRIVER=file
# SESSION_LIFETIME=120
# SESSION_ENCRYPT=true
# SESSION_COOKIE=dcms_ngrok_session
# SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE=true
# SESSION_SAME_SITE=lax
# SESSION_HTTP_ONLY=true

# CACHE_STORE=file
# QUEUE_CONNECTION=sync
# FILESYSTEM_DISK=local
# MAIL_MAILER=log
# LOG_CHANNEL=stack
# LOG_STACK=single
# LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# LOCAL URLS - ACTIVE now (normal local development, ngrok off).
# CONFLICT: when NGROK is enabled, comment out this whole block.
# -----------------------------------------------------------------------------
APP_URL=http://127.0.0.1:8000
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost,127.0.0.1

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

# =============================================================================
# HOW TO SWITCH
#
#   MySQL:
#     - put "# " in front of DB_CONNECTION=sqlite in DATABASE A
#     - remove "# " from DB_CONNECTION, DB_HOST, DB_PORT, DB_DATABASE,
#       DB_USERNAME and DB_PASSWORD in DATABASE B
#     - php artisan config:clear  &&  restart php artisan serve
#
#   Back to SQLite:
#     - reverse those two steps (uncomment DATABASE A, comment DATABASE B)
#
#   ngrok:
#     - replace YOUR-SUBDOMAIN in the NGROK block with the assigned hostname
#     - comment out the whole LOCAL URLS block
#     - comment DB_CONNECTION in DATABASE A
#     - comment COMMON APP_ENV, APP_DEBUG, LOG_CHANNEL, LOG_STACK, LOG_LEVEL,
#       CACHE_STORE, QUEUE_CONNECTION, FILESYSTEM_DISK and MAIL_MAILER,
#       then uncomment every line in the NGROK block
#     - php artisan config:clear  &&  restart php artisan serve
#
#   Back to local URLs:
#     - reverse those steps; confirm exactly one APP_ENV and one APP_URL are
#       uncommented before restarting
#
#   Always finish with:  php artisan config:clear
# =============================================================================
